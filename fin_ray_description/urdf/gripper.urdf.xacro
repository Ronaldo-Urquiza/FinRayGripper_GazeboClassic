<?xml version="1.0"?>
<robot name="fin_ray_gripper" xmlns:xacro="http://ros.org/wiki/xacro">

  <material name="soft_blue">
    <color rgba="0.145 0.588 0.745 1.0"/>
  </material>

  <material name="preto_claro">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_garra"/>
    <origin xyz="0 0 0.96" rpy="3.14159265 0 0"/>
  </joint>

  <link name="base_garra">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.150"/>
      <inertia ixx="1e-4" ixy="0.0" ixz="0.0" iyy="1e-4" iyz="0.0" izz="1e-4"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="package://fin_ray_description/meshes/base_garra.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="preto_claro"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fin_ray_description/meshes/base_garra.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

  </link>

  <gazebo reference="base_garra">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
  </gazebo>

  <xacro:macro name="contato_soft" params="ref material mu1:=1.2 mu2:=1.2 kp:=3000.0 kd:=300.0 maxVel:=0.005 minDepth:=0.002">
    <gazebo reference="${ref}">
      <material>${material}</material>
      <mu1>${mu1}</mu1>
      <mu2>${mu2}</mu2>
      <kp>${kp}</kp>
      <kd>${kd}</kd>
      <maxVel>${maxVel}</maxVel>
      <minDepth>${minDepth}</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="costeleta_prismatica" params="prefix num nome_mesh parent m cx cy cz ixx ixy ixz iyy iyz izz sx:=0.001 lim_lower:=-0.02 lim_upper:=0.0 box_x box_y box_z spring_stiffness:=100.0 spring_reference:=0.0">

    <joint name="${prefix}joint_${num}_prismatica" type="prismatic">
      <parent link="${parent}"/>
      <child link="${prefix}link_${num}"/>
      <axis xyz="1 0 0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <limit lower="${lim_lower}" upper="${lim_upper}" effort="5.0" velocity="0.5"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="${prefix}link_${num}">
      <inertial>
        <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
        <mass value="${m}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>

      <visual>
        <geometry>
          <mesh filename="package://fin_ray_description/meshes/${nome_mesh}" scale="${sx} 0.001 0.001"/>
        </geometry>
        <material name="soft_blue"/>
      </visual>

      <collision>
        <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
        <geometry>
          <box size="${box_x} ${box_y} ${box_z}"/>
        </geometry>
      </collision>
    </link>

    <xacro:contato_soft ref="${prefix}link_${num}" material="Gazebo/Turquoise"/>

    <gazebo reference="${prefix}joint_${num}_prismatica">
      <implicitSpringDamper>true</implicitSpringDamper>
      <springStiffness>${spring_stiffness}</springStiffness>
      <springReference>${spring_reference}</springReference>
    </gazebo>

  </xacro:macro>

  <joint name="dedo1_base_to_joint_1_revolute" type="revolute">
    <parent link="base_garra"/>
    <child link="dedo1_link_1_costeleta"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.030142 -0.017000 0.094917" rpy="1.5708 0 0"/>
    <limit lower="-0.5" upper="0.325" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="dedo1_link_1_costeleta">

    <inertial>
      <origin xyz="-0.000001 0.003101 0.0" rpy="0 0 0"/>
      <mass value="0.00274"/>
      <inertia ixx="94.946e-9" ixy="-0.001e-9" ixz="0.0" iyy="402.004e-9" iyz="0.0" izz="348.968e-9"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="package://fin_ray_description/meshes/1_costeleta_mirror.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="soft_blue"/>
